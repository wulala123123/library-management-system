# Generate three independent 32-byte hex database passwords, e.g. openssl rand -hex 32.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_MIGRATION_PASSWORD=
MYSQL_DB=library_db
# Only after reviewing and backing up an existing V1/V2 schema; remove after migration.
LEGACY_BASELINE_VERSION=
# openssl rand -hex 48
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_VERSION=local
FRONTEND_PORT=18080
CORS_ORIGINS=http://localhost:18080
# Enable only after the receipt workflow has passed release acceptance.
# Keep its reviewed Asia/Shanghai start date fixed across restarts and updates.
LIBRARY_FINANCE_RECEIPTS_ENABLED=false
LIBRARY_FINANCE_RECEIPTS_START_DATE=
APP_NETWORK_SUBNET=172.30.88.0/24
FRONTEND_INTERNAL_IP=172.30.88.10
# For sub2api Nginx Proxy Manager: verify its IP before setting 172.20.0.4/32.
EDGE_PROXY_CIDR=127.0.0.1/32
